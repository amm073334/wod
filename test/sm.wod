void assert(int x) {}

void turn_on() {}
void turn_off() {}

void main() {
    turn_on();
    turn_off();

    exit();
}

sm flow_insensitive on_off {
    off:
        { turn_on() } ==> on
        | { turn_off() } ==> { err("double off"); }
        ;
    on:
        { turn_off() } ==> off
        | { turn_on() } ==> { err("double on"); }
        | { exit() } ==> { err("don't forget to turn off the light"); }
        ;
}


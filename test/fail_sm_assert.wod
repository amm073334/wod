void assert(int x) {}
int do_thing() {}

void main() {
    assert(1);
    assert(1 + do_thing());
}

sm flow_insensitive check_assert {
    decl { any } expr;
    decl { any_call } any_fcall;
    decl { any_args } args;

    start: { assert(expr) } ==> { mgk_expr_recurse(expr, in_assert); };

    in_assert:
        { any_fcall(args) } ==> { err("function call"); } ;
}
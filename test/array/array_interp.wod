// EXPECT: [1, 2, 3] [x, y, z] [0, 1, 0]

apply "../../bin";

import "../_test.wod";

cev void main() {
    int[3] a;
    a[0] = 1;
    a[1] = 2;
    a[2] = 3;

    str[3] x;
    x[0] = "x";
    x[1] = "y";
    x[2] = "z";

    bool[3] m;
    m[0] = false;
    m[1] = true;
    m[2] = false;

    output("${a} ${x} ${m}");
    exit();
}
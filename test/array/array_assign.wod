// EXPECT: 4 5 6 a b 1 0 1

apply "../bin";

import "../_test.wod";

cev void main() {
    int[3] a;
    int[3] b;

    a[0] = 4;
    a[1] = 5;
    a[2] = 6;

    b = a;

    str[2] x;
    str[2] y;

    x[0] = "a";
    x[1] = "b";

    y = x;

    bool[3] m;
    bool[3] n;

    m[0] = true;
    m[1] = false;
    m[2] = true;

    n = m;

    output("${b[0]} ${b[1]} ${b[2]} ${y[0]} ${y[1]} ${n[0]} ${n[1]} ${n[2]}");
    exit();
}
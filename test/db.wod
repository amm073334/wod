cdb verts {
    int x;
    int y;
    int z;
}

inline void set_vert(int vert, int x, int y, int z) {
    verts[vert].x = x;
    verts[vert].y = y;
    verts[vert].z = z;
}

inline int dot(int a_idx, int b_idx) {
    return verts[a_idx].x * verts[b_idx].x
        + verts[a_idx].y * verts[b_idx].y
        + verts[a_idx].z * verts[b_idx].z;
}

void main() {
    int test = dot(1, 2);
}
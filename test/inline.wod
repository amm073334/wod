import "sqrt";

inline void print(str in) {
    cmd [106]()(in);
}

inline int time() {
    int out;
    cmd [121](&out, 9000030, 0, 0)();
    return out;
}

void f() {
    const int TIMES = 500000;

    int t = time();
    loop (TIMES) {
        sqrt_inline(t);
    }
    t = t - time();
    print(f"inlined time: {t}");
    
    cmd [180](1)();
    
    t = time();
    loop (TIMES) {
        sqrt(t);
    }
    t = t - time();
    print(f"call time: {t}");
}
void turn_on() {}
void turn_off() {}

void main() {
    turn_on();
    if (1) return;
    turn_off();
}

sm on_off {
    off:
        { turn_on() } ==> on
        | { turn_off() } ==> { err("double off"); }
        ;
    on:
        { turn_off() } ==> off
        | { turn_on() } ==> { err("double on"); }
        | $end_of_path$ ==> { err("don't forget to turn off the light"); }
        ;
}